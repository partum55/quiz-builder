# Used by docker-compose.yml to configure the whole stack.
# Copy to .env (scripts/setup-env.sh does this for you) and adjust if needed.

# Postgres
POSTGRES_USER=quiz
POSTGRES_PASSWORD=quiz
POSTGRES_DB=quizdb

# Backend (NestJS)
BACKEND_PORT=8000

# Frontend (Next.js)
FRONTEND_PORT=3000
# Browser-facing API URL, baked into the frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8000
